# Copy this file to .env and fill in real values. Never commit .env — it's
# gitignored, but double-check before pushing regardless.
#
# EXPO_PUBLIC_* vars get inlined into the app bundle at build time (that's
# what "PUBLIC" means to Expo), so only put keys here that are safe for a
# client to hold. TMDB and YouTube keys are designed for this. Spotify is
# NOT — that's why Spotify uses a login flow (Client ID only) instead of a
# key here; see src/lib/spotifyAuth.ts.
#
# Where to get each one: see the project's progress notes, or ask.

# TMDB — themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=

# YouTube Data API v3 — console.cloud.google.com
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Spotify — developer.spotify.com/dashboard (Client ID only, no secret)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
